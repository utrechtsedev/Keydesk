{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "keydesk-mail",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// The same Hyperdrive configuration as the app; see the README before deploying
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://keydesk:keydesk@localhost:5433/keydesk"
		}
	],
	"r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "keydesk-attachments" }],
	"durable_objects": {
		"bindings": [{ "name": "MAILBOX_SYNC", "class_name": "MailboxSync" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxSync"] }],
	// A safety net for mailbox syncs that fell behind; see `scheduled` in src/index.ts
	"triggers": { "crons": ["*/10 * * * *"] },
	"queues": {
		"consumers": [
			{
				"queue": "keydesk-jobs",
				"max_batch_size": 10,
				"max_retries": 3,
				"dead_letter_queue": "keydesk-jobs-failed"
			}
		]
	},
	"vars": {
		// Links in emails point here
		"APP_URL": "http://localhost:5173"
	}
}
