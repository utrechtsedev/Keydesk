{
	"name": "template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mail": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true vite dev workers/mail",
		"build": "vite build",
		"build:mail": "vite build workers/mail",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && bun run cf-typegen || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun src/lib/server/db/seed.ts",
		"org:create": "bun src/lib/server/db/create-organization.ts",
		"cf-typegen": "wrangler types --include-env=false && wrangler types -c workers/mail/wrangler.jsonc --strict-vars=false workers/mail/worker-configuration.d.ts",
		"check:mail": "svelte-check --tsconfig ./workers/mail/tsconfig.json"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/html-to-text": "^9.0.4",
		"@types/mailparser": "^3.9.0",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@types/sanitize-html": "^2.16.2",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-language-server": "^0.18.4",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"@dnd-kit-svelte/sortable": "^0.0.11",
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit-svelte/utilities": "^0.0.11",
		"@fontsource-variable/figtree": "^5.3.0",
		"@tanstack/svelte-table": "^9.2.8",
		"@tanstack/table-core": "^9.2.8",
		"axios": "^1.20.0",
		"better-auth": "^1.7.7",
		"csv-stringify": "^6.9.0",
		"dotenv": "^18.0.7",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"html-to-text": "^9.0.5",
		"imapflow": "^2.4.0",
		"mailparser": "^3.9.38",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.1.0",
		"pg": "^8.23.1",
		"sanitize-html": "^2.18.0",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
